{
  "name": "@connextable/popbill-examples",
  "private": true,
  "type": "module",
  "scripts": {
    "build:sdk": "pnpm --filter @connextable/popbill... build",
    "common": "dotenvx run -- jiti ./src/common/run-common.ts",
    "taxinvoice:run": "dotenvx run -- jiti ./src/tax-invoice/run-taxinvoice-usecases.ts",
    "taxinvoice:method:run": "dotenvx run -- jiti ./src/tax-invoice/run-taxinvoice-method.ts",
    "taxinvoice": "pnpm run taxinvoice:run",
    "taxinvoice:all": "pnpm run taxinvoice:run -- all",
    "taxinvoice:issue": "pnpm run taxinvoice:run -- issue",
    "taxinvoice:inquiry": "pnpm run taxinvoice:run -- inquiry",
    "taxinvoice:urls": "pnpm run taxinvoice:run -- urls",
    "taxinvoice:attachment": "pnpm run taxinvoice:run -- attachment",
    "taxinvoice:notify": "pnpm run taxinvoice:run -- notify",
    "taxinvoice:reverse": "pnpm run taxinvoice:run -- reverse",
    "taxinvoice:bulk": "pnpm run taxinvoice:run -- bulk",
    "taxinvoice:search": "pnpm run taxinvoice:run -- search",
    "taxinvoice:certificate": "pnpm run taxinvoice:run -- certificate",
    "taxinvoice:method": "pnpm run taxinvoice:method:run --",
    "taxinvoice:method:list": "pnpm run taxinvoice:method:run -- --help",
    "taxinvoice:method:list:verbose": "pnpm run taxinvoice:method:run -- --help --verbose",
    "cashbill": "dotenvx run -- jiti ./src/cashbill/run-cashbill.ts",
    "statement:run": "dotenvx run -- jiti ./src/statement/run-statement.ts",
    "statement": "pnpm run statement:run --",
    "statement:lifecycle": "pnpm run statement:run -- lifecycle",
    "statement:immediate": "pnpm run statement:run -- immediate",
    "statement:taxinvoice-attachment": "pnpm run statement:run -- taxinvoice-attachment",
    "hometax:taxinvoice": "dotenvx run -- jiti ./src/home-tax-tax-invoice/collection.ts",
    "hometax:cashbill": "dotenvx run -- jiti ./src/home-tax-cashbill/run-home-tax-cashbill.ts",
    "lookup": "dotenvx run -- jiti ./src/lookup/run-lookup.ts",
    "easyfinbank": "dotenvx run -- jiti ./src/easy-fin-bank/run-easy-fin-bank.ts",
    "kakao": "dotenvx run -- jiti ./src/kakao/run-kakao.ts",
    "message": "dotenvx run -- jiti ./src/message/run-message.ts",
    "fax": "dotenvx run -- jiti ./src/fax/run-fax.ts",
    "juso:search": "dotenvx run -- jiti ./src/juso/run-search.ts",
    "juso": "pnpm run juso:search --",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@connextable/popbill": "workspace:*",
    "@connextable/popbill-juso": "workspace:*"
  }
}
