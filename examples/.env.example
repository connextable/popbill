# Common credentials
POPBILL_LINK_ID=
POPBILL_SECRET_KEY=
POPBILL_USER_ID=
POPBILL_CORP_NUM=

# Client options
POPBILL_IS_TEST=true
POPBILL_USE_LOCAL_TIME=true
POPBILL_ACCEPT_ENCODING=gzip
POPBILL_REQUEST_TIMEOUT_MS=30000

# Common member and point queries (test environment, explicit opt-in).
POPBILL_RUN_COMMON_EXAMPLES=false

# Tax invoice examples
POPBILL_COUNTERPART_CORP_NUM=8888888888
# Optional supplier account for reverse-request refusal. Other reverse calls use POPBILL_CORP_NUM as the buyer.
POPBILL_COUNTERPART_USER_ID=
POPBILL_RECEIVER_EMAIL=test@example.com

POPBILL_SENDER_PHONE=07043042991
POPBILL_RECEIVER_PHONE=01043042991
POPBILL_SENDER_FAX=07043042991
POPBILL_RECEIVER_FAX=07043042991

# One-time assignment: itemKey of a website-issued sales invoice without a management key.
# Leave empty to skip assignInvoiceManagementKey.
POPBILL_ASSIGN_ITEM_KEY=

# Cashbill query examples (test environment, explicit opt-in).
POPBILL_RUN_CASHBILL_EXAMPLES=false
POPBILL_CASHBILL_MGT_KEY=
POPBILL_CASHBILL_SUBMIT_ID=

# Statement examples make test-environment API calls only after explicit opt-in.
POPBILL_RUN_STATEMENT_EXAMPLES=false
# Statement attach/detach use cases are skipped when this is empty.
POPBILL_STATEMENT_ITEM_CODE=121
POPBILL_STATEMENT_MGT_KEY=
# Existing editable sales invoice used by the statement taxinvoice-attachment example.
POPBILL_STATEMENT_TAXINVOICE_MGT_KEY=

# HomeTax collection examples (test environment, explicit opt-in).
POPBILL_RUN_HTTAXINVOICE_EXAMPLES=false
POPBILL_HTTAXINVOICE_DIRECTION=BUY
POPBILL_HTTAXINVOICE_START_DATE=
POPBILL_HTTAXINVOICE_END_DATE=
POPBILL_HTTAXINVOICE_JOB_ID=
POPBILL_RUN_HTCASHBILL_EXAMPLES=false
POPBILL_HTCASHBILL_DIRECTION=BUY
POPBILL_HTCASHBILL_START_DATE=
POPBILL_HTCASHBILL_END_DATE=
POPBILL_HTCASHBILL_JOB_ID=

# Business and account-holder queries (test environment, explicit opt-in).
POPBILL_RUN_LOOKUP_EXAMPLES=false
POPBILL_LOOKUP_TARGET_CORP_NUM=
POPBILL_LOOKUP_BANK_CODE=
POPBILL_LOOKUP_ACCOUNT_NUMBER=

# Bank collection examples (test environment, explicit opt-in).
POPBILL_RUN_EASYFINBANK_EXAMPLES=false
POPBILL_BANK_CODE=
POPBILL_BANK_ACCOUNT_NUMBER=
POPBILL_BANK_START_DATE=
POPBILL_BANK_END_DATE=
POPBILL_BANK_COLLECTION_ID=

# Messaging examples (test environment, explicit opt-in).
POPBILL_RUN_KAKAO_EXAMPLES=false
POPBILL_RUN_KAKAO_SEND=false
POPBILL_KAKAO_TEMPLATE_CODE=
POPBILL_KAKAO_RECEIVER_NUMBER=
POPBILL_KAKAO_MESSAGE_BODY=
POPBILL_RUN_MESSAGE_EXAMPLES=false
POPBILL_RUN_MESSAGE_SEND=false
POPBILL_MESSAGE_SENDER_NUMBER=
POPBILL_MESSAGE_RECEIVER_NUMBER=
POPBILL_RUN_FAX_EXAMPLES=false
POPBILL_ALLOW_FAX_SEND=false
POPBILL_FAX_REQUEST_NUMBER=
POPBILL_FAX_SENDER_NUMBER=
POPBILL_FAX_RECIPIENT_NUMBER=
POPBILL_FAX_FILE_PATH=
POPBILL_FAX_SCHEDULED_AT=

# Webhook receiver (independent of POPBILL_LINK_ID / POPBILL_SECRET_KEY)
POPBILL_WEBHOOK_API_KEY=
POPBILL_WEBHOOK_PORT=9854
POPBILL_WEBHOOK_INBOX_DIR=.temp/webhook-inbox
POPBILL_WEBHOOK_MAX_BYTES=1048576

# JusoLink (Address Search) Example
JUSO_LINK_ID=
JUSO_SECRET_KEY=
JUSO_ACCESS_ID=
JUSO_API_BASE_URL=
JUSO_AUTH_BASE_URL=
JUSO_FORWARDED_IP_ADDRESS=
JUSO_USE_LOCAL_TIME=true
JUSO_REQUEST_TIMEOUT_MS=30000
JUSO_ACCEPT_LANGUAGE=
JUSO_SEARCH_KEYWORD=서울 강남구 테헤란로
