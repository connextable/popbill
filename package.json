{
  "name": "@connextable/popbill-workspace",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint --continue=dependencies-successful",
    "lint:fix": "turbo run lint:fix --continue=dependencies-successful",
    "fmt": "turbo run fmt --continue=dependencies-successful",
    "fmt:check": "turbo run fmt:check --continue=dependencies-successful",
    "typecheck": "turbo run typecheck --continue=dependencies-successful && tsc -b --noEmit",
    "test": "pnpm test:release && pnpm test:docs && dotenvx run -- turbo run test --continue=dependencies-successful",
    "test:release": "vitest run scripts/release",
    "test:docs": "vitest run scripts/docs",
    "test:coverage": "dotenvx run -- turbo run test:coverage --continue=dependencies-successful",
    "docs:generate": "jiti ./scripts/generate-sdk-docs.ts",
    "release": "jiti ./scripts/release.ts",
    "clean": "turbo run clean && del node_modules .turbo"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "2.38.2",
    "@types/node": "22",
    "@typescript/typescript6": "6.0.2",
    "@vitest/coverage-v8": "5.0.5",
    "del-cli": "8.0.1",
    "globals": "17.14.0",
    "jiti": "2.7.0",
    "nano-staged": "1.0.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "simple-git-hooks": "2.14.0",
    "tsdown": "0.23.4",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "simple-git-hooks": {
    "pre-commit": "nano-staged"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
