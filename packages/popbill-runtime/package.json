{
  "name": "@connextable/popbill-runtime",
  "version": "1.1.0",
  "description": "Shared runtime clients for Popbill authentication and API transport",
  "bugs": {
    "url": "https://github.com/connextable/popbill/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/connextable/popbill.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc -b --noEmit",
    "typecheck:lib": "tsc -p tsconfig.lib.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "clean": "del node_modules dist"
  },
  "dependencies": {
    "@connextable/popbill-spec": "workspace:*",
    "@connextable/popbill-utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "20"
  },
  "engines": {
    "node": ">=20"
  }
}
