{
  "name": "@connextable/popbill-spec",
  "version": "2.0.0",
  "description": "Raw Popbill API request/response types",
  "bugs": {
    "url": "https://github.com/connextable/popbill/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/connextable/popbill.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./webhook": "./dist/webhook/index.mjs",
    "./common": "./dist/common/index.mjs",
    "./tax-invoice": "./dist/tax-invoice/index.mjs",
    "./tax-invoice/shims": "./dist/tax-invoice/shims/index.mjs",
    "./cashbill": "./dist/cashbill/index.mjs",
    "./statement": "./dist/statement/index.mjs",
    "./home-tax-tax-invoice": "./dist/home-tax-tax-invoice/index.mjs",
    "./home-tax-cashbill": "./dist/home-tax-cashbill/index.mjs",
    "./closedown": "./dist/closedown/index.mjs",
    "./biz-info-check": "./dist/biz-info-check/index.mjs",
    "./easy-fin-bank": "./dist/easy-fin-bank/index.mjs",
    "./account-check": "./dist/account-check/index.mjs",
    "./kakao": "./dist/kakao/index.mjs",
    "./message": "./dist/message/index.mjs",
    "./fax": "./dist/fax/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc -b --noEmit",
    "clean": "del node_modules dist"
  },
  "devDependencies": {
    "@types/node": "20"
  },
  "engines": {
    "node": ">=20"
  }
}
